<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Bluetooth permissions for talking to the Stripe Reader M2.
      `BLUETOOTH_SCAN` + `BLUETOOTH_CONNECT` replace the legacy `BLUETOOTH` / `BLUETOOTH_ADMIN`
      pair on API 31+. The `neverForLocation` flag tells Android we're not deriving the user's
      location from BLE scan results — that's an OS-level carve-out for the Bluetooth stack only.

      `ACCESS_FINE_LOCATION` is required on EVERY Android version — not just API 30 and earlier.
      This is a Stripe Terminal SDK requirement (it tags the payment location for fraud
      prevention when discovering readers, Bluetooth M2 or Tap to Pay alike), independent of the
      Bluetooth `neverForLocation` flag above. A previous `maxSdkVersion="30"` cap here made the
      permission silently absent from the merged manifest on API 31+ devices — Android then
      auto-denies any runtime request for an undeclared permission, so `discoverReaders()` failed
      with "You must request location permissions before discovering readers" on every device
      running API 31 or later, unconditionally.

      Foreground service permissions support the connected-device service type required by
      Android 14+ for long-running Bluetooth peripherals.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
      Legacy permissions for API 29–30 — BLUETOOTH_SCAN/CONNECT didn't exist yet so the
      older runtime needs BLUETOOTH + BLUETOOTH_ADMIN. Capped at maxSdkVersion=30 so API 31+
      installs don't request them.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
      Tap to Pay on Android (Phase 5) — the phone's own NFC reader accepts the card.
      `NFC` permission is required by the Stripe Tap to Pay path. The Stripe SDK contributes
      its own Tap to Pay service/manifest entries via manifest merge, so nothing further is
      declared here.
    -->
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!--
      NFC is `required="false"` on purpose: a single APK still installs on non-NFC / API 29
      devices (which use the Bluetooth M2 path). Tap to Pay availability is gated at runtime by
      `DeviceCapability`, not by Play Store install filtering.
    -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application>
        <service
            android:name=".service.StripeReaderService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
